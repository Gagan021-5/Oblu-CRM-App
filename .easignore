# =============================================================================
# Root .easignore — EAS Build Archive Configuration
# =============================================================================
# Used by EAS CLI when packaging the repository for EAS cloud builds.
# Keeps private backend/biometrics out of cloud build archives, while ensuring
# local app assets (Frontend/assets/images and Frontend/assets/fonts) ARE included.

# Backend & Virtual Envs (not needed for mobile APK build)
ObluMerge/
venv/
.venv/
env/
ENV/
*.sqlite3
media/
**/media/
attendance/
**/attendance/
employees/
**/employees/
**/faces/
deploy/

# Node & Expo artifacts
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
*.tsbuildinfo

# Prebuilt native folders
Frontend/android/
Frontend/ios/
callapp/android/
callapp/ios/
android/
ios/

# Metro & caches
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.pnpm-debug.*

# Secrets
.env
.env*.local
*.pem
*.key
